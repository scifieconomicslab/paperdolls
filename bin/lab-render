#!/usr/bin/env python3
"""Run lab-render from a checkout or an installed plugin, with no pip install of this package.

Claude Code puts the plugin's bin/ folder on the Bash tool's PATH, so a skill can simply run `lab-render ...`.
The three Python packages it needs are listed in requirements.txt; `lab-render doctor` checks them.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lab_render.cli import main

if __name__ == "__main__":
    main()
